          "id": "django-start",
          "title": "Основы Django",
          "lessons": ["dj-01-django-vs-flask", "dj-02-pervyi-proekt", "dj-03-modeli-i-admin", "dj-04-views-i-shablony"]
        },
        {
          "id": "django-api",
          "title": "API и качество",
          "lessons": ["dj-05-formy-i-validatsiya", "dj-06-drf", "dj-07-auth-v-django", "dj-08-testy-v-django"]
        }
      ]
    },
    {
      "id": "production",
      "order": 10,
      "icon": "rocket",
      "gradient": ["#f43f5e", "#f97316"],
      "title": "Продакшн и диплом",
      "tagline": "Тесты, безопасность, Docker, CI/CD, деплой и итоговый проект",
      "modules": [
        {
          "id": "quality",
          "title": "Качество и безопасность",
          "lessons": ["pr-01-testy-pytest", "pr-02-bezopasnost", "pr-03-logging"]
        },
        {
          "id": "deploy",
          "title": "Доставка кода",
          "lessons": ["pr-04-docker", "pr-05-ci-cd", "pr-06-wsgi-i-nginx", "pr-07-deploy"]
        },
        {
          "id": "capstone",
          "title": "Дипломный проект",
          "lessons": ["pr-08-arhitektura-proekta", "pr-09-chto-dalshe"]
        }
      ]
    }
