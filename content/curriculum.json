      "order": 6,
      "icon": "snake",
      "gradient": ["#3b82f6", "#22c55e"],
      "title": "Python: язык",
      "tagline": "Второй язык — с нуля до ООП, файлов и стандартной библиотеки",
      "modules": [
        {
          "id": "py-start",
          "title": "Первые шаги",
          "lessons": ["py-01-ustanovka-i-skript", "py-02-peremennye-i-tipy", "py-03-stroki", "py-04-chisla-i-operatory"]
        },
        {
          "id": "py-control",
          "title": "Логика и коллекции",
          "lessons": ["py-05-usloviya", "py-06-tsikly", "py-07-spiski", "py-08-slovari-i-mnozhestva", "py-09-kortezhi"]
        },
        {
          "id": "py-functions",
          "title": "Функции и ошибки",
          "lessons": ["py-10-funktsii", "py-11-argumety-i-scope", "py-12-isklyucheniya", "py-13-faily"]
        },
        {
          "id": "py-oop",
          "title": "ООП и экосистема",
          "lessons": ["py-14-klassy", "py-15-nasledovanie-i-magic", "py-16-moduli-i-venv", "py-17-stdlib", "py-18-tipizatsiya"]
        }
      ]
    },
    {
      "id": "backend",
      "order": 7,
      "icon": "server",
      "gradient": ["#8b5cf6", "#6366f1"],
      "title": "Бэкенд на Flask",
      "tagline": "HTTP изнутри, REST API, шаблоны, сессии и структура приложения",
      "modules": [
        {
          "id": "http-and-rest",
          "title": "HTTP и REST",
          "lessons": ["be-01-chto-takoe-bekend", "be-02-http-glubzhe", "be-03-rest-api"]
        },
        {
          "id": "flask-core",
          "title": "Flask: ядро",
          "lessons": ["be-04-flask-hello", "be-05-marshruty", "be-06-zaprosy-i-formy", "be-07-json-api"]
        },
        {
          "id": "flask-app",
          "title": "Flask: приложение",
          "lessons": ["be-08-jinja2", "be-09-sessii-i-auth", "be-10-blueprints", "be-11-proekt-todo-api"]
        }
      ]
    },
    {
      "id": "databases",
      "order": 8,
      "icon": "database",
      "gradient": ["#0ea5e9", "#6366f1"],
      "title": "Базы данных и SQL",
      "tagline": "Реляционные модели, SQL-запросы, SQLite и SQLAlchemy",
      "modules": [
        {
          "id": "sql-basics",
          "title": "SQL",
          "lessons": ["db-01-zachem-nuzhna-bd", "db-02-select", "db-03-filtry-i-sortirovka", "db-04-join", "db-05-agregaty"]
        },
        {
          "id": "db-python",
          "title": "БД из Python",
          "lessons": ["db-06-sqlite-v-python", "db-07-sqlalchemy", "db-08-indeksy-i-migratsii"]
        }
      ]
    },
    {
      "id": "django",
      "order": 9,
      "icon": "layers",
      "gradient": ["#10b981", "#84cc16"],
      "title": "Django: полный стек",
      "tagline": "Батареи в комплекте: модели, админка, DRF и тесты",
      "modules": [
