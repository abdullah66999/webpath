        {
          "id": "css-polish",
          "title": "Дизайн-система и полировка",
          "lessons": ["css-09-peremennye-i-temy", "css-10-perekhody-i-animatsii", "css-11-sovremennyi-ui"]
        }
      ]
    },
    {
      "id": "js",
