{
  "title": "Путь веб-разработчика",
  "tagline": "От первой HTML-страницы до собственного бэкенда на Python",
  "stages": [
    {
      "id": "start",
      "order": 1,
      "icon": "compass",
      "gradient": ["#6366f1", "#22d3ee"],
      "title": "Старт: как устроен веб",
      "tagline": "Клиент, сервер, HTTP и инструменты, без которых дальше не поехать",
      "modules": [
        {
          "id": "how-web-works",
          "title": "Как работает веб",
          "lessons": ["start-01-chto-takoe-veb", "start-02-http-i-brauzer", "start-03-instrumenty", "start-04-devtools"]
        },
        {
          "id": "cli-and-git",
          "title": "Терминал и Git",
          "lessons": ["start-05-terminal", "start-06-git-basics"]
        }
      ]
    },
    {
      "id": "html",
      "order": 2,
      "icon": "code",
      "gradient": ["#f97316", "#fbbf24"],
      "title": "HTML: структура страницы",
      "tagline": "Разметка, семантика, формы и доступность",
      "modules": [
        {
          "id": "html-foundations",
          "title": "Основы разметки",
          "lessons": ["html-01-struktura-dokumenta", "html-02-tegi-i-atributy", "html-03-tekst-i-semantika", "html-04-ssylki-i-izobrazheniya"]
        },
        {
          "id": "html-data",
          "title": "Списки, таблицы, формы",
          "lessons": ["html-05-spiski-i-tablitsy", "html-06-formy-i-polya", "html-07-validatsiya-form"]
        },
        {
          "id": "html-a11y",
          "title": "Доступность и мета",
          "lessons": ["html-08-dostupnost", "html-09-seo-i-meta"]
        }
      ]
    },
    {
      "id": "css",
      "order": 3,
      "icon": "palette",
      "gradient": ["#ec4899", "#a855f7"],
      "title": "CSS: внешний вид",
      "tagline": "От селекторов до сеток, анимаций и современного UI",
      "modules": [
